# systemd-сервис демона панели.
# Установка (путь /opt/trofeo-panel поменяйте на свой):
#   sudo cp trofeo-panel.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now trofeo-panel
# Логи: journalctl -u trofeo-panel -f
[Unit]
Description=Trofeo Vision 11.3 LCD panel daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
# Каталог проекта (тот, где лежит run.sh)
WorkingDirectory=/opt/trofeo-panel
ExecStart=/opt/trofeo-panel/run.sh
Environment=PORT=8888
Restart=always
RestartSec=3
# Панель дёргает watchdog при зависании отправки
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
